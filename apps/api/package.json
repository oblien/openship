{
  "name": "@repo/api",
  "version": "0.9.11",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "OPENSHIP_DEV_LOCK_TAKEOVER=true node --env-file=.env --import tsx --watch src/index.ts",
    "dev:saas": "OPENSHIP_DEV_LOCK_TAKEOVER=true node --env-file=.env.saas --import tsx --watch src/index.ts",
    "dev:local-saas": "OPENSHIP_DEV_LOCK_TAKEOVER=true node --env-file=.env.local-saas --import tsx --watch src/index.ts",
    "build": "tsup src/index.ts --format esm && node scripts/copy-assets.mjs",
    "build-release": "bun scripts/build-release.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "cloud:check": "bun scripts/cloud-readiness.ts",
    "referral": "node --import tsx scripts/referral.ts",
    "billing:grant": "bun scripts/plan-grant.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@better-auth/core": "1.7.15",
    "@better-auth/drizzle-adapter": "1.7.15",
    "@better-auth/oauth-provider": "1.7.15",
    "@discordjs/rest": "2.6.3",
    "@discordjs/ws": "2.0.4",
    "@hono/node-server": "^2.1.3",
    "@hono/node-ws": "^1.3.1",
    "@hono/typebox-validator": "^0.3.0",
    "@repo/adapters": "workspace:*",
    "@repo/commands": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/platform": "workspace:*",
    "@sinclair/typebox": "^0.34.48",
    "@slack/socket-mode": "3.1.0",
    "better-auth": "1.7.15",
    "bullmq": "^5.70.4",
    "bytesmap": "0.1.2",
    "cron-parser": "^4.9.0",
    "hono": "^4.13.18",
    "ioredis": "^5.10.0",
    "ipaddr.js": "^2.4.0",
    "jose": "6.2.13",
    "maxmind": "^5.0.6",
    "nodemailer": "^10.5.0",
    "pino": "^10.3.1",
    "stripe": "^20.4.0",
    "ws": "^8.21.3",
    "yaml": "^2.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/sdk": "workspace:*",
    "@types/node": "^22.13.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
