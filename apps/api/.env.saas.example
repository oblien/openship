# Openship API — SaaS development example.
# Copy to .env.saas for SaaS-mode development. Do not commit real secrets.
# `dev:saas` loads this file (node --env-file=.env.saas) — it is the ONLY thing
# that differs from `dev` (which loads .env). No mode logic lives in any script.
#
# SINGLE knob — OPENSHIP_TARGET — picks the runtime-target row. The
# table at packages/core/src/runtime-config.ts is the source of URLs.
#   OPENSHIP_TARGET=local        → self-hosted (the .env default)
#   OPENSHIP_TARGET=local-saas   → localhost SaaS for dev (dashboard :3002, api :4100)
#   OPENSHIP_TARGET=cloud-saas   → the production SaaS (api.openship.io)
# OPENSHIP_CLOUD_TARGET points where "cloud" calls go; local-saas keeps them on localhost.

NODE_ENV=development

OPENSHIP_TARGET=local-saas
OPENSHIP_CLOUD_TARGET=local-saas
CLOUD_MODE=true
DEPLOY_MODE=cloud

# Isolated PGlite store so the localhost SaaS never shares data with self-hosted
# (~/.openship/data). Leading ~ is expanded by the db client.
PGLITE_DATA_DIR=~/.openship/data-saas

DATABASE_URL=

BETTER_AUTH_SECRET=change-me-in-production

# Required outside desktop mode. Fronts trusted Electron↔API endpoints
# (/setup, /desktop-auth-start). Boot refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_TOKEN=change-me-32-byte-random-hex

# Required for cloud deployments.
OBLIEN_API_URL=https://api.oblien.com
OBLIEN_CLIENT_ID=
OBLIEN_CLIENT_SECRET=
# Choose a random signing secret. API startup registers the callback with
# Oblien using this same secret; inbound deliveries are verified against it.
OBLIEN_WEBHOOK_SECRET=
# Defaults to the selected runtime's API + /api/billing/oblien-webhook.
# OBLIEN_WEBHOOK_URL=https://api.openship.io/api/billing/oblien-webhook

# Purchases default off. Set true to test/launch subscriptions and credit
# top-ups. Reads and existing subscription management remain available.
BILLING_ENABLED=false
BILLING_TOPUPS_ENABLED=false
# Production must receive these through its actual runtime environment.
# Docker Compose reads the root .env, not this dev:saas file.

# Required for GitHub App mode.
GITHUB_APP_ID=
GITHUB_APP_SLUG=openship-io
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=

SYSTEM_DEBUG_LOGS=false
