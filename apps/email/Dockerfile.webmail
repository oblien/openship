# syntax=docker/dockerfile:1
# ─── openship-webmail ────────────────────────────────────────────────────────
# Zero webmail as a self-contained image: the pre-built client SPA plus the
# Hono/Bun server that serves it and talks IMAP/SMTP.
#
# This is the WEBMAIL CLIENT, not the mail engine. `apps/email/Dockerfile` (no
# suffix) builds `openship-mail` — the iRedMail daemon set. The two share this
# directory and nothing else: webmail speaks only IMAP/SMTP, so it runs against
# any backend (our engine, Gmail, Fastmail, a corporate Exchange) and is
# versioned as its own product. It is installed like every other catalog app
# (packages/core/src/apps/catalog/webmail.json) — openship's TypeScript holds no
# webmail deployment facts.
#
# Why a published image and not a catalog `build` (the inline-Dockerfile mode
# neon.json uses): that mode runs `docker build` ON THE DEPLOY HOST, and the
# client's Vite pass peaks around 1.5 GB RSS — it OOM-killed small VPSes, which
# is the whole reason `scripts/build-release.ts` exists. Building here once per
# release means the target only pulls.
#
# Dev loop without cutting a release: the compose deploy is pull-if-missing
# (`forcePull` is set only by the "update" trigger — compose/deploy.service.ts),
# so an image already on the target box wins. Build it under the same ref the
# catalog names and redeploy:
#
#     docker build -f apps/email/Dockerfile.webmail \
#       -t ghcr.io/oblien/openship-webmail:latest .
#
# Context is the repo root only because .github/workflows/docker-images.yml
# builds every image with `context: .`; the COPYs below take four paths.
# ─────────────────────────────────────────────────────────────────────────────

FROM oven/bun:1.3.3 AS builder
WORKDIR /src

# apps/email/{client,server} are NOT workspace members — the root package.json's
# "workspaces" is ["apps/*", "packages/*"], which matches apps/email but not its
# subdirectories — and they carry no @repo/* dependency. So there are no root
# manifests to copy and no monorepo install: this image builds from these four
# paths alone. (node_modules and dist are excluded by the root .dockerignore.)
COPY apps/email/package.json ./package.json
COPY apps/email/scripts ./scripts
COPY apps/email/server ./server
COPY apps/email/client ./client

# `resolve-catalog-refs` rewrites `"foo": "catalog:"` in the two vendored Zero
# package.json files (they came from a pnpm monorepo we don't have) to semver.
# The committed files are already resolved, so this is a no-op here and
# --frozen-lockfile holds. That pairing is deliberate: if Zero is re-pulled
# upstream and reintroduces a `catalog:` ref, the rewrite moves package.json and
# the frozen install FAILS in CI — rather than silently resolving a different
# dependency graph into a published image.
#
# The client keeps its devDependencies: vite / react-router / wrangler / tailwind
# ARE the build. Hence no NODE_ENV=production in this stage — bun treats that as
# an implicit --production and would drop exactly those.
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun run scripts/resolve-catalog-refs.ts \
 && cd server && bun install --frozen-lockfile \
 && cd ../client && bun install --frozen-lockfile

# ONE build entrypoint, shared with the standalone release tarball that
# .github/workflows/release.yml publishes (`bun run --cwd apps/email build` →
# openship-email-<tag>-linux-amd64.tar.gz). The image and the tarball are the
# same bits from the same script, so they cannot drift.
#
# DIST_DIR moves the output off apps/email/dist — the path the script defaults
# to and the root .dockerignore excludes from the context.
#
# The trailing install is not redundant: build-release generates
# /out/server/bun.lock and then deletes node_modules, because the tarball ships
# a lockfile rather than 130 MB of deps. The image wants the deps resolved at
# BUILD time (a container must not install on boot), so we restore them from the
# lockfile it just wrote. --frozen-lockfile is therefore guaranteed to hold, and
# the shared BuildKit cache makes the second pass nearly free.
RUN --mount=type=cache,target=/root/.bun/install/cache \
    DIST_DIR=/out bun run scripts/build-release.ts \
 && cd /out/server && bun install --production --frozen-lockfile

# ─── Runtime ─────────────────────────────────────────────────────────────────
FROM oven/bun:1.3.3 AS runner
WORKDIR /app

# The release layout verbatim: client/ (static SPA), server/{src,node_modules,
# package.json,bun.lock}, plus the tarball's package.json/start.sh/README.md.
# Bun runs the server's TypeScript directly — there is no transpiled output to
# select between.
COPY --from=builder /out ./

# The container runs as root: the oven/bun images set no USER. Deliberate here —
# /data is a volume, created root-owned on first run, and Zero mkdir -p's both
# state paths under it at boot (src/db/index.ts, src/lib/branding.ts).
#
# PORT is 4080, not the server's own 3030 default: 4080 is what the release
# README documents and what the catalog's endpoint declares.
ENV NODE_ENV=production \
    PORT=4080 \
    CLIENT_BUILD_DIR=/app/client \
    SQLITE_PATH=/data/zero.db \
    BRANDING_PATH=/data/branding

# Everything in this image that must outlive a container:
#   zero.db     encrypted IMAP session rows, user settings, hotkeys, templates.
#               Losing it signs every user out.
#   branding/   config.json + assets — the white-label login page.
# Both env vars above point inside /data, so one mount covers all state. Every
# redeploy is a new container off a new image, which is exactly when an
# undeclared path disappears — and silently, since root can always write it.
RUN mkdir -p /data
VOLUME /data

EXPOSE 4080

# Exec form on purpose: the shell form would hand this to /bin/sh, and these
# images ship no curl or wget, so the probe is bun itself. `bun -e` keeps it to
# one process with no argument quoting to get wrong.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD \
  ["bun", "-e", "fetch('http://127.0.0.1:' + (process.env.PORT || 4080) + '/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]

CMD ["bun", "run", "server/src/main.ts"]
