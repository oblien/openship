{
  "name": "@repo/platform",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./engine/*": {
      "types": "./src/engine/*.ts",
      "import": "./src/engine/*.ts"
    },
    "./native": {
      "types": "./src/native-host.ts",
      "import": "./src/native-host.ts"
    },
    "./source-files": {
      "types": "./src/source-files.ts",
      "import": "./src/source-files.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "build:native": "bun run build-native.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.5.4",
    "@octokit/auth-oauth-device": "^8.0.3",
    "@octokit/request": "^10.0.8",
    "@repo/adapters": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/db": "workspace:*",
    "@sinclair/typebox": "^0.34.48",
    "better-auth": "^1.5.4",
    "bullmq": "^5.70.4",
    "cron-parser": "^4.9.0",
    "dockerode": "^4.0.9",
    "ioredis": "^5.10.0",
    "ipaddr.js": "^2.4.0",
    "maxmind": "^5.0.6",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "ssh2": "^1.17.0",
    "stripe": "^20.4.0",
    "tar": "^7.5.22",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "@types/nodemailer": "^8.0.1"
  }
}
