{
  "name": "@repo/core",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./ports": {
      "types": "./src/ports.ts",
      "import": "./src/ports.ts"
    },
    "./scale": {
      "types": "./src/scale/index.ts",
      "import": "./src/scale/index.ts"
    }
  },
  "//typesVersions": "Electron main (apps/desktop) emits CommonJS, so it is stuck on classic moduleResolution, which predates `exports` maps and cannot see the ./ports subpath. This is how that resolver finds it; modern consumers use `exports` above.",
  "typesVersions": {
    "*": {
      "ports": [
        "./src/ports.ts"
      ],
      "scale": [
        "./src/scale/index.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/scale/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/scale/index.ts --format esm --dts --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
