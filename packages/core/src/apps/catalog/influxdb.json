{
  "$schema": "https://openship.io/app.schema.json",
  "available": false,
  "verified": true,
  "id": "influxdb",
  "name": "InfluxDB",
  "description": "A time-series database for metrics and events, with its initial org, bucket, and admin API token set up automatically.",
  "kind": "template",
  "logo": "influxdb",
  "category": "database",
  "repository": "https://github.com/influxdata/influxdb",
  "tags": ["database", "time-series", "metrics", "analytics"],
  "framework": "docker-compose",
  "services": [
    {
      "name": "influxdb",
      "image": "influxdb:2.7.12",
      "exposed": true,
      "exposedPort": 8086,
      "restart": "unless-stopped",
      "volumes": ["influxdb_data:/var/lib/influxdb2", "influxdb_config:/etc/influxdb2"],
      "environment": {
        "DOCKER_INFLUXDB_INIT_MODE": "setup",
        "DOCKER_INFLUXDB_INIT_USERNAME": "admin",
        "DOCKER_INFLUXDB_INIT_ORG": "openship",
        "DOCKER_INFLUXDB_INIT_BUCKET": "default"
      },
      "secretEnv": ["DOCKER_INFLUXDB_INIT_PASSWORD", "DOCKER_INFLUXDB_INIT_ADMIN_TOKEN"],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl -fsS http://127.0.0.1:8086/health | grep -q '\"status\": *\"pass\"' || exit 1"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 10,
        "startPeriod": "20s"
      }
    }
  ],
  "configFields": [
    {
      "key": "DOCKER_INFLUXDB_INIT_PASSWORD",
      "service": "influxdb",
      "label": "Admin password",
      "generate": "secret",
      "secret": true
    },
    {
      "key": "DOCKER_INFLUXDB_INIT_ADMIN_TOKEN",
      "service": "influxdb",
      "label": "Admin API token",
      "help": "Auto-generated. Grants full read/write access to every org and bucket — treat it like a root credential.",
      "generate": "secret",
      "secret": true
    }
  ],
  "endpoints": [
    {
      "service": "influxdb",
      "port": 8086,
      "label": "InfluxDB",
      "kind": "http",
      "defaultMode": "domain"
    }
  ],
  "connection": {
    "title": "Sign in to InfluxDB",
    "description": "Sign in with the username and generated password below, or use the admin API token for scripts and clients.",
    "guide": {
      "defaultMode": "public"
    },
    "outputs": [
      {
        "id": "url",
        "label": "InfluxDB",
        "source": "publicUrl:influxdb",
        "kind": "url",
        "recommended": true
      },
      {
        "id": "username",
        "label": "Username",
        "source": "env:influxdb:DOCKER_INFLUXDB_INIT_USERNAME",
        "width": "half"
      },
      {
        "id": "password",
        "label": "Password",
        "source": "env:influxdb:DOCKER_INFLUXDB_INIT_PASSWORD",
        "secret": true,
        "width": "half"
      },
      {
        "id": "org",
        "label": "Organization",
        "source": "env:influxdb:DOCKER_INFLUXDB_INIT_ORG",
        "width": "half"
      },
      {
        "id": "bucket",
        "label": "Initial bucket",
        "source": "env:influxdb:DOCKER_INFLUXDB_INIT_BUCKET",
        "width": "half"
      },
      {
        "id": "token",
        "label": "Admin API token",
        "source": "env:influxdb:DOCKER_INFLUXDB_INIT_ADMIN_TOKEN",
        "secret": true,
        "help": "Use this for the InfluxDB CLI, client libraries, and Telegraf — it never needs a login."
      }
    ],
    "firstLogin": {
      "note": "Account and token changes made in the app are preserved on redeployment. These are the initial credentials, set up automatically on first start."
    }
  },
  "marketplace": {
    "features": [
      {
        "title": "Automatic setup",
        "description": "The initial organization, bucket, and admin API token are created on first start, no manual setup wizard."
      },
      {
        "title": "Time-series storage",
        "description": "Purpose-built for metrics, events, and other time-stamped data."
      },
      {
        "title": "Persistent storage",
        "description": "Data and config stay on project-scoped volumes across deployments."
      }
    ]
  }
}
