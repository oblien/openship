{
  "$schema": "https://openship.io/app.schema.json",
  "available": false,
  "verified": true,
  "minEngine": "0.9.2",
  "id": "postiz",
  "name": "Postiz",
  "description": "Open-source social media scheduler: plan, publish and analyse posts across X, LinkedIn, Facebook, Instagram, YouTube, TikTok and more, with a private PostgreSQL database, Redis, and the Temporal workflow engine, and a preconfigured administrator.",
  "kind": "template",
  "logo": "postiz",
  "category": "other",
  "repository": "https://github.com/gitroomhq/postiz-app",
  "tags": [
    "social-media",
    "scheduler",
    "marketing",
    "publishing"
  ],
  "framework": "docker-compose",
  "settings": [
    {
      "id": "setup",
      "label": "Initial account",
      "columns": 2,
      "fields": [
        {
          "key": "POSTIZ_ADMIN_EMAIL",
          "service": "postiz",
          "label": "Admin email",
          "type": "text",
          "default": "admin@example.com",
          "required": true,
          "installStep": true,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "patternError": "Enter an email address.",
          "help": "Used to sign in. Registration closes once this first account exists."
        }
      ]
    }
  ],
  "installLayout": {
    "settings": "single",
    "columns": 2
  },
  "endpoints": [
    {
      "service": "postiz",
      "port": 5000,
      "label": "Postiz",
      "kind": "http",
      "defaultMode": "domain"
    },
    {
      "service": "postiz-db",
      "port": 5432,
      "label": "Database",
      "kind": "tcp",
      "scope": "internal",
      "defaultMode": "internal",
      "allowedModes": [
        "internal"
      ]
    }
  ],
  "prepare": [
    {
      "service": "postiz",
      "title": "Create the administrator",
      "description": "Registers the first account through Postiz's own API. Postiz then closes registration, so nobody else can sign up.",
      "command": "cd /app && node <<'OPENSHIP_JS'\nconst E = process.env;\nconst base = \"http://127.0.0.1:5000/api\";\nconst email = E.POSTIZ_ADMIN_EMAIL;\nconst password = E.POSTIZ_ADMIN_PASSWORD;\nconst call = (path, body) =>\n  fetch(base + path, { method: \"POST\", headers: { \"content-type\": \"application/json\" }, body: JSON.stringify(body) });\n(async () => {\n  let r = await call(\"/auth/login\", { provider: \"LOCAL\", email, password });\n  if (!r.ok) {\n    r = await call(\"/auth/register\", { provider: \"LOCAL\", email, password, company: \"Openship\" });\n    if (!r.ok) throw new Error(\"register failed (\" + r.status + \"): \" + (await r.text()).slice(0, 120));\n    r = await call(\"/auth/login\", { provider: \"LOCAL\", email, password });\n    if (!r.ok) throw new Error(\"sign-in after register failed (\" + r.status + \")\");\n  }\n  console.log(\"postiz administrator ready\");\n})().catch((x) => {\n  console.error(\"ERR:\", x.message);\n  process.exit(1);\n});\nOPENSHIP_JS",
      "capture": "postiz_admin_setup",
      "once": true,
      "mustSucceed": true,
      "phase": "post-ready",
      "readiness": {
        "test": "node -e \"fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))\"",
        "interval": 3000,
        "retries": 200
      }
    }
  ],
  "minResources": {
    "cpuCores": 2,
    "memoryMb": 4096
  },
  "marketplace": {
    "features": [
      {
        "title": "Schedule everywhere",
        "description": "One calendar for posts to X, LinkedIn, Facebook, Instagram, YouTube, TikTok, Reddit, Mastodon and more."
      },
      {
        "title": "Private data",
        "description": "Posts, media and accounts live in a dedicated PostgreSQL instance and local storage on your server."
      },
      {
        "title": "Durable publishing",
        "description": "A bundled Temporal workflow engine retries and tracks every scheduled post."
      }
    ]
  },
  "services": [
    {
      "name": "postiz-db",
      "image": "postgres:17-alpine",
      "restart": "unless-stopped",
      "environment": {
        "POSTGRES_USER": "postiz",
        "POSTGRES_DB": "postiz"
      },
      "secretEnv": [
        "POSTGRES_PASSWORD"
      ],
      "volumes": [
        "postiz_db_data:/var/lib/postgresql/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\""
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 12,
        "startPeriod": "20s"
      }
    },
    {
      "name": "postiz-redis",
      "image": "redis:7.4.12-alpine",
      "restart": "unless-stopped",
      "volumes": [
        "postiz_redis_data:/data"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "redis-cli",
          "ping"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 12,
        "startPeriod": "5s"
      }
    },
    {
      "name": "temporal-db",
      "image": "postgres:16-alpine",
      "restart": "unless-stopped",
      "environment": {
        "POSTGRES_USER": "temporal"
      },
      "secretEnv": [
        "POSTGRES_PASSWORD"
      ],
      "volumes": [
        "temporal_db_data:/var/lib/postgresql/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U \"$POSTGRES_USER\""
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 12,
        "startPeriod": "20s"
      }
    },
    {
      "name": "temporal-es",
      "image": "elasticsearch:7.17.27",
      "restart": "unless-stopped",
      "environment": {
        "discovery.type": "single-node",
        "ES_JAVA_OPTS": "-Xms256m -Xmx256m",
        "xpack.security.enabled": "false",
        "cluster.routing.allocation.disk.threshold_enabled": "true",
        "cluster.routing.allocation.disk.watermark.low": "512mb",
        "cluster.routing.allocation.disk.watermark.high": "256mb",
        "cluster.routing.allocation.disk.watermark.flood_stage": "128mb"
      },
      "volumes": [
        "temporal_es_data:/usr/share/elasticsearch/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl -fsS -o /dev/null http://127.0.0.1:9200/_cluster/health || exit 1"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 30,
        "startPeriod": "30s"
      }
    },
    {
      "name": "temporal",
      "image": "temporalio/auto-setup:1.28.1",
      "restart": "unless-stopped",
      "dependsOn": [
        "temporal-db",
        "temporal-es"
      ],
      "environment": {
        "DB": "postgres12",
        "DB_PORT": "5432",
        "POSTGRES_USER": "temporal",
        "POSTGRES_SEEDS": "temporal-db",
        "DYNAMIC_CONFIG_FILE_PATH": "config/dynamicconfig/development-sql.yaml",
        "ENABLE_ES": "true",
        "ES_SEEDS": "temporal-es",
        "ES_VERSION": "v7",
        "TEMPORAL_NAMESPACE": "default"
      },
      "secretEnv": [
        "POSTGRES_PWD"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "tctl --address \"$(hostname -i):7233\" --namespace default namespace describe >/dev/null 2>&1 || exit 1"
        ],
        "interval": "10s",
        "timeout": "10s",
        "retries": 30,
        "startPeriod": "60s"
      }
    },
    {
      "name": "postiz",
      "image": "ghcr.io/gitroomhq/postiz-app:v2.25.3",
      "restart": "unless-stopped",
      "dependsOn": [
        "postiz-db",
        "postiz-redis",
        "temporal"
      ],
      "ports": [
        "8236:5000"
      ],
      "exposed": true,
      "exposedPort": 5000,
      "routes": [
        {
          "port": 5000
        }
      ],
      "entrypointArgv": [
        "sh",
        "-c",
        "case \"$MAIN_URL\" in https://*) ;; *) export NOT_SECURED=true;; esac; exec docker-entrypoint.sh sh -c 'nginx && pnpm run pm2'"
      ],
      "volumes": [
        "postiz_config:/config/",
        "postiz_uploads:/uploads/"
      ],
      "environment": {
        "MAIN_URL": "{{publicUrl:postiz}}",
        "FRONTEND_URL": "{{publicUrl:postiz}}",
        "NEXT_PUBLIC_BACKEND_URL": "{{publicUrl:postiz}}/api",
        "BACKEND_INTERNAL_URL": "http://localhost:3000",
        "DATABASE_URL": "postgresql://postiz:{{config:DB_PASSWORD}}@postiz-db:5432/postiz",
        "REDIS_URL": "redis://postiz-redis:6379",
        "TEMPORAL_ADDRESS": "temporal:7233",
        "IS_GENERAL": "true",
        "DISABLE_REGISTRATION": "true",
        "STORAGE_PROVIDER": "local",
        "UPLOAD_DIRECTORY": "/uploads",
        "NEXT_PUBLIC_UPLOAD_DIRECTORY": "/uploads",
        "NX_ADD_PLUGINS": "false"
      },
      "secretEnv": [
        "DATABASE_URL",
        "JWT_SECRET",
        "POSTIZ_ADMIN_PASSWORD"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "node -e \"fetch('http://127.0.0.1:5000/api/').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))\" || exit 1"
        ],
        "interval": "15s",
        "timeout": "10s",
        "retries": 20,
        "startPeriod": "180s"
      }
    }
  ],
  "configFields": [
    {
      "key": "POSTGRES_PASSWORD",
      "service": "postiz-db",
      "label": "Database password",
      "generate": "secret",
      "secret": true,
      "generateGroup": "postiz-db"
    },
    {
      "key": "DB_PASSWORD",
      "service": "postiz",
      "label": "Database password (app side)",
      "generate": "secret",
      "secret": true,
      "generateGroup": "postiz-db"
    },
    {
      "key": "POSTGRES_PASSWORD",
      "service": "temporal-db",
      "label": "Workflow database password",
      "generate": "secret",
      "secret": true,
      "generateGroup": "temporal-db"
    },
    {
      "key": "POSTGRES_PWD",
      "service": "temporal",
      "label": "Workflow database password (engine side)",
      "generate": "secret",
      "secret": true,
      "generateGroup": "temporal-db"
    },
    {
      "key": "JWT_SECRET",
      "service": "postiz",
      "label": "Session signing secret",
      "help": "Auto-generated. Signs login sessions; changing it signs everyone out.",
      "generate": "secret",
      "secret": true
    },
    {
      "key": "POSTIZ_ADMIN_PASSWORD",
      "service": "postiz",
      "label": "Administrator password",
      "help": "Auto-generated. Shown on the Connection card.",
      "generate": "secret",
      "secret": true
    }
  ],
  "files": [
    {
      "service": "temporal",
      "path": "/etc/temporal/config/dynamicconfig/development-sql.yaml",
      "content": "limit.maxIDLength:\n  - value: 255\n    constraints: {}\nsystem.forceSearchAttributesCacheRefreshOnRead:\n  - value: true\n    constraints: {}\n"
    }
  ],
  "connection": {
    "title": "Sign in to Postiz",
    "description": "Sign in with the email and generated password below. The account is created on first start, so no confirmation email is needed.",
    "guide": {
      "defaultMode": "public"
    },
    "outputs": [
      {
        "id": "url",
        "label": "Postiz",
        "source": "publicUrl:postiz",
        "kind": "url",
        "recommended": true
      },
      {
        "id": "email",
        "label": "Email",
        "source": "env:postiz:POSTIZ_ADMIN_EMAIL",
        "width": "half"
      },
      {
        "id": "password",
        "label": "Password",
        "source": "env:postiz:POSTIZ_ADMIN_PASSWORD",
        "secret": true,
        "width": "half"
      }
    ],
    "firstLogin": {
      "note": "Registration is closed after this first account, so add teammates from inside the app. To publish you connect each social network with your own developer app (client ID and secret), added as environment variables on the postiz service. Outgoing email is not configured. The first start registers the account and sets up the workflow engine, so allow a few minutes."
    }
  }
}
