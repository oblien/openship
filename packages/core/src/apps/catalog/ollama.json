{
  "$schema": "https://openship.io/app.schema.json",
  "schemaVersion": 2,
  "supportsCloud": false,
  "available": true,
  "verified": true,
  "kind": "template",
  "category": "ai",
  "framework": "docker-compose",
  "id": "ollama",
  "name": "Ollama",
  "logo": "ollama",
  "gpu": "recommended",
  "repository": "https://github.com/ollama/ollama",
  "description": "Run language models on your own server, with a persistent model library and a private inference API.",
  "tags": ["ai", "llm", "inference", "ollama", "gpu"],
  "minResources": {
    "cpuCores": 2,
    "memoryMb": 4096
  },
  "services": [
    {
      "name": "ollama",
      "image": "ollama/ollama:0.40.4",
      "exposedPort": 11434,
      "gpus": {
        "driver": "nvidia",
        "count": 1,
        "capabilities": ["gpu"]
      },
      "environment": {
        "OLLAMA_HOST": "0.0.0.0:11434",
        "OLLAMA_CONTEXT_LENGTH": "4096",
        "OLLAMA_NUM_PARALLEL": "1",
        "OLLAMA_KEEP_ALIVE": "5m"
      },
      "volumes": ["ollama_data:/root/.ollama"],
      "restart": "unless-stopped",
      "healthcheck": {
        "test": ["CMD", "ollama", "list"],
        "interval": "15s",
        "timeout": "10s",
        "retries": 5,
        "startPeriod": "60s"
      }
    }
  ],
  "endpoints": [
    {
      "service": "ollama",
      "port": 11434,
      "kind": "tcp",
      "label": "Model API",
      "help": "Ollama has no API authentication. Keep it private and use Open in localhost or connect it to another project.",
      "scope": "internal",
      "defaultMode": "internal",
      "allowedModes": ["internal"]
    }
  ],
  "settings": [
    {
      "id": "inference",
      "label": "Inference",
      "description": "Model size determines the memory and disk needed. Download models from Terminal with ollama pull <model>.",
      "columns": 2,
      "fields": [
        {
          "key": "OLLAMA_CONTEXT_LENGTH",
          "service": "ollama",
          "label": "Context length",
          "type": "number",
          "default": "4096",
          "min": 512,
          "max": 131072,
          "installStep": true
        },
        {
          "key": "OLLAMA_NUM_PARALLEL",
          "service": "ollama",
          "label": "Parallel requests",
          "type": "number",
          "default": "1",
          "min": 1,
          "max": 8,
          "installStep": true
        }
      ]
    }
  ],
  "management": {
    "kind": "schema"
  },
  "connection": {
    "title": "Connect to Ollama",
    "description": "Download a model in Terminal, for example: ollama pull qwen3:0.6b. The API has no authentication and stays private. Use Open in localhost for a client on your machine.",
    "outputs": [
      {
        "id": "apiUrl",
        "label": "Private model API",
        "source": "template:http://ollama:11434",
        "service": "ollama",
        "envKey": "OLLAMA_BASE_URL",
        "recommended": true
      }
    ]
  },
  "provides": [
    {
      "id": "ollama-api",
      "category": "ai",
      "outputRefs": ["apiUrl"]
    }
  ],
  "marketplace": {
    "articleFile": "articles/ollama.md",
    "features": [
      {
        "title": "CPU or NVIDIA",
        "description": "Choose CPU mode or request one NVIDIA GPU."
      },
      {
        "title": "Persistent models",
        "description": "Keep downloaded models across redeployment."
      },
      {
        "title": "Private API",
        "description": "Connect applications without publishing an unauthenticated API."
      }
    ]
  }
}
